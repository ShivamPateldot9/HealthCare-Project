      <aliases enabled='yes' />
      <column caption='No-Show Rate' datatype='real' name='[Calculation_4876523333197824]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [no_show] = &quot;Yes&quot; THEN 1 ELSE 0 END ) / COUNT([no_show])' />
      </column>
      <column caption='Lead Time Bucket' datatype='string' name='[Calculation_4876523335368705]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [lead_time_days] = 0 THEN &quot;1. Same Day&quot;&#10;ELSEIF [lead_time_days] &gt;= 1 AND [lead_time_days] &lt;= 3 THEN &quot;2. Short(1-3 Days)&quot;&#10;ELSEIF [lead_time_days] &gt;= 4 AND [lead_time_days] &lt;= 7 THEN &quot;3. Within a week&quot;&#10;ELSE &quot;4. Long Lead (8+ Days)&quot;&#10;END' />
      </column>
